{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotel-st-cloud-pages",
  "compatibility_date": "2026-05-03",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "kv_namespaces": [
    {
      "binding": "PLANNER_DATA",
      "id": "23e0e4247bdb47a29f501158a2c935d6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAINTENANCE_UPLOADS",
      "bucket_name": "unbridled-maintenance-uploads"
    }
  ]
}
